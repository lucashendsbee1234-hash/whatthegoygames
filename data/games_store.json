  "GTA3.html": {
    "filename": "GTA3.html",
    "title": "GTA III",
    "content": "<!-- This is an Ultimate game stash file -->\r\n<!-- for regular updating go to https://docs.google.com/document/d/1_FmH3BlSBQI7FGgAQL59-ZPe8eCxs35wel6JUyVaG8Q/edit?usp=sharing -->\r\n\r\n<!doctype html>\r\n<html lang=\"en\">\r\n<head>\r\n    <base href=\"https://cdn.jsdelivr.net/gh/larpinguser/HelloWorldScriptBasicFunctionCSharpIsCool@main/\">\r\n<meta charset=\"utf-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title>GTA III</title>\r\n<style>\r\n  body {\r\n    margin: 0;\r\n    background: #000;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    height: 100vh;\r\n    overflow: hidden;\r\n  }\r\n  canvas.emscripten {\r\n    display: block;\r\n    width: min(100vw, calc(100vh * 16 / 9));\r\n    height: min(100vh, calc(100vw * 9 / 16));\r\n    image-rendering: auto;\r\n  }\r\n  #loading {\r\n    color: #fff;\r\n    font: 14px monospace;\r\n    position: absolute;\r\n    top: 50%;\r\n    left: 50%;\r\n    transform: translate(-50%, -50%);\r\n  }\r\n</style>\r\n</head>\r\n<body>\r\n<div id=\"loading\">Loading GTA III...</div>\r\n<script>\r\n  window.addEventListener('unhandledrejection', function(e) {\r\n    if (e.reason && e.reason.name && e.reason.name.indexOf('DocumentError') !== -1) {\r\n      e.preventDefault();\r\n      return;\r\n    }\r\n    document.getElementById('loading').textContent = 'ERR: ' + (e.reason && e.reason.message ? e.reason.message : e.reason);\r\n  });\r\n  (function() {\r\n    var _rpl = Element.prototype.requestPointerLock;\r\n    if (_rpl) Element.prototype.requestPointerLock = function() {\r\n      try { var p = _rpl.call(this); if (p && p.catch) p.catch(function(){}); return p; }\r\n      catch(e) {}\r\n    };\r\n  })();\r\n</script>\r\n<script>\r\n  (function() {\r\n    var ORIG_FETCH = window.fetch;\r\n    window.fetch = function(url, opts) {\r\n      if (typeof url === 'string' && /re3\\.data$/i.test(url) && !/\\.(chunk|part)/.test(url)) {\r\n        return loadDataParts();\r\n      }\r\n      return ORIG_FETCH.call(this, url, opts);\r\n    };\r\n    async function loadDataParts() {\r\n      var parts = [];\r\n      for (var i = 0; ; i++) {\r\n        var resp = await ORIG_FETCH.call(window, 're3.chunk.' + i);\r\n        if (!resp.ok) break;\r\n        parts.push(await resp.arrayBuffer());\r\n      }\r\n      var total = parts.reduce(function(s, p) { return s + p.byteLength; }, 0);\r\n      var combined = new Uint8Array(total);\r\n      var offset = 0;\r\n      for (var pi = 0; pi < parts.length; pi++) {\r\n        combined.set(new Uint8Array(parts[pi]), offset);\r\n        offset += parts[pi].byteLength;\r\n      }\r\n      return new Response(combined, {\r\n        status: 200,\r\n        headers: { 'Content-Type': 'application/octet-stream' }\r\n      });\r\n    }\r\n    var origGetContext = HTMLCanvasElement.prototype.getContext;\r\n    HTMLCanvasElement.prototype.getContext = function(type, attrs) {\r\n      if (type.indexOf('webgl') === 0 || type.indexOf('experimental-webgl') === 0) {\r\n        attrs = Object.assign({}, attrs || {}, { preserveDrawingBuffer: true });\r\n      }\r\n      return origGetContext.call(this, type, attrs);\r\n    };\r\n  })();\r\n\r\n  Element.prototype.requestFullscreen =\r\n  Element.prototype.webkitRequestFullscreen = function() {\r\n    return Promise.reject(new DOMException(\"blocked\"));\r\n  };\r\n  document.exitFullscreen =\r\n  document.webkitExitFullscreen = function() {};\r\n  Object.defineProperty(document, 'fullscreenElement', {\r\n    get: function() { return null; }\r\n  });\r\n  Object.defineProperty(document, 'webkitFullscreenElement', {\r\n    get: function() { return null; }\r\n  });\r\n  Object.defineProperty(document, 'fullscreenEnabled', {\r\n    get: function() { return false; }\r\n  });\r\n  Object.defineProperty(document, 'webkitFullscreenEnabled', {\r\n    get: function() { return false; }\r\n  });\r\n\r\n  (function() {\r\n    var RealAC = window.AudioContext || window.webkitAudioContext;\r\n    if (!RealAC) return;\r\n    var contexts = [];\r\n    function resumeAll() {\r\n      for (var i = 0; i < contexts.length; i++) {\r\n        var ctx = contexts[i];\r\n        if (ctx.state === 'suspended') ctx.resume();\r\n      }\r\n    }\r\n    document.addEventListener('click', resumeAll);\r\n    document.addEventListener('touchstart', resumeAll);\r\n    document.addEventListener('keydown', resumeAll);\r\n    var Wrapper = function(options) {\r\n      var ctx = new RealAC(options);\r\n      contexts.push(ctx);\r\n      if (ctx.state === 'suspended') ctx.resume().catch(function(){});\r\n      return ctx;\r\n    };\r\n    Wrapper.prototype = RealAC.prototype;\r\n    window.AudioContext = Wrapper;\r\n    if (window.webkitAudioContext) window.webkitAudioContext = Wrapper;\r\n  })();\r\n</script>\r\n<script>\r\n  var Module = {\r\n    preRun: [],\r\n    postRun: [],\r\n    canvas: (function() {\r\n      var canvas = document.getElementById('canvas');\r\n      if (!canvas) {\r\n        canvas = document.createElement('canvas');\r\n        canvas.id = 'canvas';\r\n        canvas.className = 'emscripten';\r\n        document.body.appendChild(canvas);\r\n      }\r\n      return canvas;\r\n    })(),\r\n    setStatus: function(text) {\r\n      var loading = document.getElementById('loading');\r\n      if (loading) loading.textContent = text;\r\n    },\r\n    totalDependencies: 0,\r\n    monitorRunDependencies: function(left) {\r\n      this.totalDependencies = Math.max(this.totalDependencies, left);\r\n      Module.setStatus(left ? 'Preparing... (' + (this.totalDependencies - left) + '/' + this.totalDependencies + ')' : '');\r\n    }\r\n  };\r\n  Module.setStatus('Loading...');\r\n</script>\r\n<script src=\"re3.js\"></script>\r\n</body>\r\n</html>",
